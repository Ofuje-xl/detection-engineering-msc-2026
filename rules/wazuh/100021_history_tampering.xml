<!--
  Detection: Shell history tampering
  MITRE ATT&CK: T1070.003 - Clear Command History
  Author: Jeffrey Ofuje Adegoke
  Telemetry source: Auditd (system-call layer)
  Required Auditd key: history_tamper

  Detection rationale:
  Baseline Wazuh 4.13 decoded the event and exposed
  audit.key="history_tamper" together with audit.command, but the
  event terminated at rule 80700, level 0, so no actionable alert
  was generated.

  This rule requires both the history_tamper key and a destructive
  command. This excludes normal shell-history writes, which are
  recorded with the shell as audit.command, and reduces the alert
  multiplication observed with Rule 100020.

  Known limitation:
  The rule does not detect redirection-based history clearing, such
  as writing /dev/null to .bash_history, because the shell performs
  the write and audit.command therefore records the shell rather than
  rm, truncate, or shred. See dissertation Section 4.3.

  Wazuh deployment path:
  /var/ossec/etc/rules/local_rules.xml
-->

<group name="audit,history_tampering,">
  <rule id="100021" level="10">
    <if_group>audit</if_group>
    <field name="audit.key">history_tamper</field>
    <field name="audit.command">^rm$|^truncate$|^shred$</field>
    <description>History tampering: shell history file deleted or truncated (T1070.003)</description>
    <mitre>
      <id>T1070.003</id>
    </mitre>
  </rule>
</group>
