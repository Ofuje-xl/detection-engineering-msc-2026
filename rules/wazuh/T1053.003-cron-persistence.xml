<!--
  Detection: Cron persistence
  MITRE ATT&CK: T1053.003 - Cron
  Author: Jeffrey Ofuje Adegoke
  Telemetry source: Auditd (system-call layer)
  Required Auditd key: cron

  Detection rationale:
  Baseline Wazuh 4.13 decoded the Auditd event and exposed
  audit.key="cron", but the event terminated at rule 80700,
  level 0, so no actionable alert was generated.

  This rule elevates events carrying the cron key to level 10.
  The intentionally broad key-only condition was evaluated to
  determine whether the available Auditd telemetry could convert
  the baseline gap into an actionable detection.

  Evaluated limitations:
  The broad condition also matched legitimate cron activity. During
  controlled benign testing, all six benign cron scenarios generated
  at least one alert. Individual operations could also generate
  multiple alerts because multiple associated Auditd events carried
  the same cron key; a single evaluated persistence action generated
  three Rule 100020 alerts.

  The rule should therefore be treated as experimental detection
  content requiring additional contextual filtering before operational
  deployment.

  Wazuh deployment path:
  /var/ossec/etc/rules/local_rules.xml
-->

<group name="audit,cron_persistence,">
  <rule id="100020" level="10">
    <if_group>audit</if_group>
    <field name="audit.key">cron</field>
    <description>Cron persistence: file written to a cron directory (T1053.003)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
  </rule>
</group>
