<!--
  Detection: SSH authorized_keys persistence
  MITRE ATT&CK: T1098.004 - SSH Authorized Keys
  Author: Jeffrey Ofuje Adegoke
  Telemetry source: Auditd (system-call layer)
  Required Auditd key: ssh_key_change

  Detection rationale:
  Baseline Wazuh 4.13 decoded the Auditd event and exposed
  audit.key="ssh_key_change", but the event terminated at rule 80700,
  level 0, so no actionable alert was generated.

  This rule intentionally matches on the audit key alone. The key is
  generated by a watch bound to the authorized_keys resource, so it
  identifies a sensitive file change rather than a broad execution
  category. Adding a command filter would reduce procedure coverage,
  because the file could be modified through tee, sed, an editor, shell
  redirection, or other mechanisms.

  Evaluated decoder limitation:
  audit.file.name is defined in Wazuh's Auditd decoder but was not
  populated for the observed events. A path-based rule condition was
  therefore not available in the evaluated configuration.

  Wazuh deployment path:
  /var/ossec/etc/rules/local_rules.xml
-->

<group name="audit,ssh_key_persistence,">
  <rule id="100022" level="10">
    <if_group>audit</if_group>
    <field name="audit.key">ssh_key_change</field>
    <description>SSH persistence: authorized_keys file modified (T1098.004)</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
  </rule>
</group>
